# Copy to deploy/.env and replace placeholders. Never commit deploy/.env.
# Use a fixed sha-<commit> tag first, then record/pin the published digest.
API_IMAGE=ghcr.io/g-gorton/e-library-service-api:replace-with-sha-tag
WEB_IMAGE=ghcr.io/g-gorton/e-library-service-web:replace-with-sha-tag
DATABASE_PASSWORD=replace-with-a-long-random-database-password
APP_ADMIN_EMAIL=admin@example.invalid
APP_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
APP_PROFILE=prod
APP_SEED_DEMO=false

# No hostname or production certificate is supplied by this repository.
PUBLIC_HOSTNAME=library.example.invalid
APP_PUBLIC_BASE_URL=https://library.example.invalid:4443
# Optional trusted Funnel HTTPS origin; account emails can include this backup link.
APP_PUBLIC_BACKUP_BASE_URL=
WEB_HTTP_PORT=18081
WEB_HTTPS_PORT=4443
# HTTP-only origin for initial checks/Funnel. For IPv6 TLS set ./Caddyfile.https.
CADDY_CONFIG_FILE=./Caddyfile

# Production email is a separate setup dependency; empty host does not send mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false
APP_MAIL_ENABLED=false
APP_MAIL_FROM=noreply@example.invalid
