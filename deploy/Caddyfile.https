{
	admin off
	auto_https disable_redirects
}

(application) {
	root * /srv
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
	respond /healthz "ok" 200
	handle /api/* {
		reverse_proxy api:8080
	}
	handle /media/* {
		reverse_proxy api:8080
	}
	handle /swagger-ui* {
		reverse_proxy api:8080
	}
	handle /v3/api-docs* {
		reverse_proxy api:8080
	}
	handle {
		try_files {path} /index.html
		file_server
	}
}

# Local origin for Funnel / a trusted reverse proxy. Published on loopback only.
http://:8080 {
	import application
}

# Certificates are obtained/renewed externally because NAS ports 80/443 are in use.
https://{$PUBLIC_HOSTNAME:localhost}:8443 {
	tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem
	import application
}
